    <string name="score_title">Focus score</string>
    <string name="score_intro">A 0–100 score recomputed every few seconds from today\'s usage only. It drives the pet\'s state.</string>
    <string name="score_part_minutes">50 points — minutes vs. the limit</string>
    <string name="score_part_minutes_body">Total minutes across limited apps divided by the total of their limits. 0%% usage = 50 points, 100%% = 0. A fully blocked app counts as a one-minute limit.</string>
    <string name="score_part_opens">30 points — number of opens</string>
    <string name="score_part_opens_body">The target is one open per 10 minutes of limit (at least 3 per app). Under the target = 30 points, double the target = 0. Returning to an app within 2 seconds does not count.</string>
    <string name="score_part_streak">20 points — longest clean streak today</string>
    <string name="score_part_streak_body">The longest stretch today without opening any limited app. Two hours = all 20 points.</string>
    <string name="score_stages_title">From score to pet</string>
    <string name="score_stages_body">90+ perfect · 70–89 good · 50–69 okay · 30–49 declining · 10–29 bad · under 10 rotten</string>
