    <string name="score_title">ציון המיקוד</string>
    <string name="score_intro">ציון בין 0 ל-100 שמחושב מחדש כל כמה שניות מהשימוש של היום בלבד. הוא מזין את מצב המחמד.</string>
    <string name="score_part_minutes">50 נקודות — דקות מול הגבול</string>
    <string name="score_part_minutes_body" formatted="false">סכום הדקות בכל האפליקציות המוגבלות חלקי סכום הגבולות. 0% שימוש = 50 נקודות, 100% = 0 נקודות. אפליקציה בחסימה מלאה נחשבת לגבול של דקה אחת.</string>
    <string name="score_part_opens">30 נקודות — מספר פתיחות</string>
    <string name="score_part_opens_body">יעד הפתיחות הוא פתיחה אחת לכל 10 דקות גבול (ולפחות 3 לאפליקציה). מתחת ליעד = 30 נקודות, פי שתיים מהיעד = 0. חזרה לאפליקציה תוך פחות מ-2 שניות לא נספרת.</string>
    <string name="score_part_streak">20 נקודות — הרצף הנקי הארוך ביום</string>
    <string name="score_part_streak_body">הזמן הארוך ביותר שעבר היום בלי לפתוח אף אפליקציה מוגבלת. שעתיים = מלוא 20 הנקודות.</string>
