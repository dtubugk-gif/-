# --- Server ---
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://api.your-domain.com
DATA_DIR=/data
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 24  (protects /admin endpoints)
ADMIN_TOKEN=
DEFAULT_COUNTRY=US

# --- Telnyx (https://portal.telnyx.com) ---
TELNYX_API_KEY=
# Keys & Credentials > Public Key (used to verify webhook signatures)
TELNYX_PUBLIC_KEY=
# Voice > Programmable Voice > your Call Control application id.
# Set its webhook URL to  ${PUBLIC_BASE_URL}/webhooks/telnyx  and assign every forwarding number to it.
TELNYX_CONNECTION_ID=
# Verify > Verify Profiles (SMS) — sends sign-up codes
TELNYX_VERIFY_PROFILE_ID=
# Optional: SMS fallback alerts for users without push
TELNYX_MESSAGING_PROFILE_ID=
SMS_FROM_NUMBER=

# A regular (non-toll-free) Telnyx number on the same Call Control app.
# The server calls the user from it during setup; the user declines; we watch it come back.
VERIFICATION_CALLER_ID=
# Optional public demo line: call it with *67 and it reads your real number back.
DEMO_LINE_NUMBER=

OTP_PROVIDER=telnyx

# --- Billing ---
# revenuecat | free   (free = everyone is entitled; use for beta testing)
ENTITLEMENT_MODE=revenuecat
# RevenueCat > Integrations > Webhooks > Authorization header value
REVENUECAT_WEBHOOK_AUTH=

# --- Voicemail ---
TTS_VOICE_EN=female
TTS_VOICE_HE=Azure.he-IL-HilaNeural
MAX_RECORDING_SECONDS=120
DIAGNOSTICS_RETENTION_DAYS=14
