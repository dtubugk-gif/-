    <string name="onboarding_welcome_title">ברוכים הבאים לרקבון</string>
    <string name="onboarding_welcome_body">מגדירים גבולות לאפליקציות שמסיחות. המחמד שלכם נרקב כשעוברים אותם ומתאושש כשעומדים בהם. בלי מספרים, בלי נזיפות. רק ריקבון.</string>
    <string name="onboarding_usage_title">גישה לנתוני שימוש</string>
    <string name="onboarding_usage_body">כדי לדעת כמה זמן פתחתם כל אפליקציה, אנדרואיד דורש הרשאה מיוחדת. הנתונים נשארים בטלפון. בלי ההרשאה הזו אין מעקב ואין חסימה.</string>
    <string name="onboarding_overlay_title">הצגה מעל אפליקציות אחרות</string>
    <string name="onboarding_overlay_body">מסך החסימה מופיע מעל האפליקציה שעברה את הגבול. בלי ההרשאה הזו המחמד יירקב בשקט, אבל שום דבר לא ייחסם.</string>
    <string name="onboarding_instant_title">חסימה מיידית</string>
    <string name="onboarding_instant_body">אופציונלי. עם שירות הנגישות דולק, אפליקציה חסומה נסגרת ברגע שהיא נפתחת, כמו בבקרת הורים, במקום שנייה אחר כך. רקבון משתמש בשירות רק כדי לדעת איזו אפליקציה עלתה לחזית ולהחזיר אתכם למסך הבית. הוא לעולם לא קורא תוכן מהמסך. הפעילו את ״רקבון – חסימה מיידית״ תחת אפליקציות מותקנות.</string>
    <string name="onboarding_notifications_title">התראות</string>
    <string name="onboarding_notifications_body">התראה אחת שקטה כדי שהשירות ימשיך לעבוד, ואופציונלית סיכום ערב בקול של המחמד. בלי תזכורות טורדניות. אפשר לדלג.</string>
    <string name="onboarding_alarm_title">איפוס מדויק בחצות</string>
    <string name="onboarding_alarm_body">הרשאה לתזמון מדויק כדי שהמחמד יתעורר רענן בדיוק ב-00:00. גם בלי זה האיפוס קורה, רק כמה דקות מאוחר יותר.</string>
    <string name="onboarding_battery_title">אופטימיזציית סוללה</string>
    <string name="onboarding_battery_body">חלק מהיצרנים הורגים שירותים ברקע כדי לחסוך סוללה. פטור מאופטימיזציה שומר על המעקב חי לאורך היום. הצריכה בפועל קטנה.</string>
    <string name="onboarding_done_title">זהו</string>
    <string name="onboarding_done_body">עכשיו בוחרים אפליקציות, קובעים גבול, ומסתכלים מה קורה למחמד.</string>
    <string name="onboarding_grant">אישור ההרשאה</string>
    <string name="onboarding_granted">ההרשאה ניתנה</string>
    <string name="onboarding_next">הבא</string>
