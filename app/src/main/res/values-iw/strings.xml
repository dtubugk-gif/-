    <string name="battery_title">אופטימיזציית סוללה</string>
    <string name="battery_intro">כדי לחסום אפליקציות, רקבון חייב להישאר ער ברקע. חלק מהיצרנים הורגים שירותים כאלה בלי לשאול. שני צעדים פותרים את זה.</string>
    <string name="battery_step_system">1. פטור מאופטימיזציה של אנדרואיד</string>
    <string name="battery_step_system_body">מאפשר לשירות לרוץ גם במצב Doze. הצריכה בפועל: פולינג קצר כל כמה שניות רק כשהמסך דולק.</string>
    <string name="battery_open_system">פתיחת הגדרת הסוללה</string>
    <string name="battery_open_vendor">פתיחת הגדרות היצרן</string>
    <string name="battery_open_app_info">פתיחת פרטי האפליקציה</string>
    <string name="battery_vendor_xiaomi">2. Xiaomi / Redmi / POCO</string>
    <string name="battery_vendor_xiaomi_body">אבטחה › הרשאות › הפעלה אוטומטית: הפעילו לרקבון. בנוסף: סוללה › חיסכון בסוללה לאפליקציה › ללא הגבלות.</string>
    <string name="battery_vendor_samsung">2. Samsung</string>
    <string name="battery_vendor_samsung_body">הגדרות › טיפול במכשיר › סוללה › מגבלות שימוש ברקע: הוציאו את רקבון מ״אפליקציות בשינה״ והוסיפו ל״אפליקציות שלא ישנות״.</string>
    <string name="battery_vendor_huawei">2. Huawei / Honor</string>
    <string name="battery_vendor_huawei_body">מנהל הטלפון › הפעלת אפליקציות: כבו ניהול אוטומטי לרקבון והשאירו את שלוש האפשרויות דלוקות.</string>
    <string name="battery_vendor_oppo">2. OPPO / Realme</string>
    <string name="battery_vendor_oppo_body">הגדרות › סוללה › אופטימיזציית סוללה לאפליקציה: רקבון › אל תבצע אופטימיזציה. ובנוסף: הפעלה אוטומטית.</string>
    <string name="battery_vendor_vivo">2. vivo / iQOO</string>
    <string name="battery_vendor_vivo_body">i Manager › מנהל אפליקציות › הפעלה אוטומטית: הפעילו לרקבון. סוללה › צריכת רקע גבוהה: אפשרו.</string>
    <string name="battery_vendor_oneplus">2. OnePlus</string>
    <string name="battery_vendor_oneplus_body">הגדרות › סוללה › אופטימיזציית סוללה: רקבון › אל תבצע אופטימיזציה. במכשירים ישנים גם ״הפעלה אוטומטית״.</string>
    <string name="battery_vendor_other">2. היצרן שלכם</string>
    <string name="battery_vendor_other_body">במכשירי Pixel ורוב היצרנים האחרים הפטור למעלה מספיק. אם השירות בכל זאת נעצר, חפשו בהגדרות ״הפעלה אוטומטית״ או ״אפליקציות ברקע״.</string>

    <string name="privacy_title">פרטיות</string>
    <string name="privacy_summary">אפס רשת. אפס אנליטיקס. אפס SDK צד שלישי. הכול נשאר בטלפון.</string>
    <string name="privacy_collect_title">מה האפליקציה אוספת</string>
    <string name="privacy_collect_body">רשימת האפליקציות המותקנות, זמן השימוש ומספר הפתיחות שלהן היום ובעד 90 הימים האחרונים, הגבולות ולוחות הזמנים שהגדרתם, הציון היומי, רצפים והישגים. הכול כדי להציג לכם את המחמד והסטטיסטיקות.</string>
    <string name="privacy_network_title">לאן זה הולך</string>
    <string name="privacy_network_body">לשום מקום. לאפליקציה אין הרשאת אינטרנט בכלל. אין שרת, אין חשבון, אין מזהה מכשיר.</string>
    <string name="privacy_permissions_title">למה ההרשאות</string>
    <string name="privacy_permissions_body">גישה לנתוני שימוש: כדי למדוד דקות ופתיחות. הצגה מעל אפליקציות: כדי להראות את מסך החסימה. רשימת כל האפליקציות: כדי שתוכלו לבחור מה להגביל. התראות: ההתראה השקטה של השירות וסיכום ערב אופציונלי.</string>
    <string name="privacy_storage_title">איפה זה נשמר</string>
    <string name="privacy_storage_body">במסד נתונים מקומי בתוך האפליקציה. היסטוריה מעבר ל-90 יום נמחקת אוטומטית. גיבוי נוצר רק אם אתם מייצאים קובץ בעצמכם.</string>
    <string name="privacy_delete_title">מחיקה</string>
    <string name="privacy_delete_body">מחיקת האפליקציה מוחקת את כל הנתונים. אין עותק בשום מקום אחר.</string>

    <string name="premium_title">רקבון פרימיום</string>
    <string name="premium_intro">הגרסה החינמית שלמה ושמישה. פרימיום מסיר את המכסות ופותח את כל המחמדים מיד. בלי מודעות, בלי תזכורות תשלום.</string>
    <string name="premium_free_title">חינם, לתמיד</string>
    <string name="premium_free_body">עד %1$d אפליקציות מוגבלות, %2$d לוח זמנים, שני מחמדים מיידיים והשאר נפתחים בהישגים. מצב קשוח, סטטיסטיקות, ווידג׳ט וגיבוי כלולים.</string>
    <string name="premium_paid_title">פרימיום</string>
