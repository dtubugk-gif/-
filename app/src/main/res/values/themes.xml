<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rikavon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Launch theme: the platform splash (icon only, no custom loading screen), then Theme.Rikavon. -->
    <style name="Theme.Rikavon.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rikavon</item>
    </style>
</resources>
