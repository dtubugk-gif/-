<?xml version="1.0" encoding="utf-8"?>
<!-- Only performs input sent by the computer during "Project to computer"; reads no screen content
     except the focused text field, so typed text can be inserted at the cursor. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagInputMethodEditor"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/control_service_description"
    android:notificationTimeout="200" />
