<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Draggable bubble handle. Tap toggles the panel; drag moves the window. -->
    <ImageView
        android:id="@+id/bubbleButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bubble_bg"
        android:padding="14dp"
        android:src="@drawable/ic_speaker"
        android:contentDescription="@string/overlay_title" />

    <!-- Expandable panel with the clip buttons. -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="12dp"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_hint"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/containerClips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnOverlayStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/stop_playback" />

        <Button
            android:id="@+id/btnOverlayClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_close" />
    </LinearLayout>

</LinearLayout>
